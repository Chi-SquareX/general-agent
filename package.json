{
  "name": "general-agent",
  "version": "0.1.0",
  "description": "General-agent: extracted core Claude-style agentic framework with customizable tools.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "src/entrypoints/cli.tsx",
  "bin": {
    "general-agent": "src/entrypoints/cli.tsx"
  },
  "scripts": {
    "build": "bun scripts/build-bundle.ts",
    "build:watch": "bun scripts/build-bundle.ts --watch",
    "build:prod": "bun scripts/build-bundle.ts --minify",
    "agent-server": "bun src/entrypoints/agent-server.tsx",
    "build:web": "bun scripts/build-web.ts",
    "build:web:watch": "bun scripts/build-web.ts --watch",
    "build:web:prod": "bun scripts/build-web.ts --minify",
    "typecheck": "tsc --noEmit --skipLibCheck src/features.ts",
    "lint": "biome check src/features.ts src/tools.config.ts README.md docs/adding-tools.md docs/architecture.md PROVENANCE.md",
    "lint:fix": "biome check --write src/features.ts src/tools.config.ts README.md docs/adding-tools.md docs/architecture.md PROVENANCE.md",
    "format": "biome format --write src/features.ts src/tools.config.ts README.md docs/adding-tools.md docs/architecture.md PROVENANCE.md",
    "check": "bun run lint && bun run typecheck"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "^0.3.0",
    "@anthropic-ai/bedrock-sdk": "^0.29.1",
    "@anthropic-ai/mcpb": "^2.1.2",
    "@anthropic-ai/sdk": "^0.39.0",
    "@anthropic-ai/vertex-sdk": "^0.16.0",
    "@aws-sdk/client-bedrock": "^3.1045.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1045.0",
    "@aws-sdk/client-sts": "^3.1045.0",
    "@aws-sdk/credential-provider-node": "^3.972.39",
    "@commander-js/extra-typings": "^13.1.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@smithy/core": "^3.23.17",
    "@smithy/node-http-handler": "^4.6.1",
    "auto-bind": "^5.0.1",
    "axios": "^1.7.0",
    "bidi-js": "^1.0.3",
    "chalk": "^5.4.0",
    "chokidar": "^4.0.0",
    "cli-boxes": "^3.0.0",
    "code-excerpt": "^4.0.0",
    "color-diff-napi": "^0.0.1",
    "diff": "^7.0.0",
    "env-paths": "^4.0.0",
    "execa": "^9.5.0",
    "fflate": "^0.8.2",
    "figures": "^6.1.0",
    "fuse.js": "^7.0.0",
    "google-auth-library": "^10.6.2",
    "highlight.js": "^11.11.0",
    "https-proxy-agent": "^9.0.0",
    "ignore": "^6.0.0",
    "indent-string": "^5.0.0",
    "jsonc-parser": "^3.3.1",
    "lodash-es": "^4.17.21",
    "lru-cache": "^11.3.6",
    "marked": "^15.0.0",
    "p-map": "^7.0.0",
    "picomatch": "^4.0.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.0.0",
    "react-reconciler": "^0.31.0",
    "semver": "^7.6.0",
    "stack-utils": "^2.0.6",
    "strip-ansi": "^7.1.0",
    "supports-hyperlinks": "^3.1.0",
    "tree-kill": "^1.2.2",
    "type-fest": "^4.30.0",
    "undici": "^7.3.0",
    "wrap-ansi": "^9.0.0",
    "ws": "^8.18.0",
    "xss": "^1.0.15",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/diff": "^7.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.10.0",
    "@types/picomatch": "^3.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.0.0",
    "@types/semver": "^7.5.8",
    "@types/stack-utils": "^2.0.3",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "packageManager": "bun@1.1.0"
}
